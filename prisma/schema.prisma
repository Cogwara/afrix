datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  WORKER
  BUSINESS
  ADMIN
  REVIEWER
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  REVIEWER
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  FUNDED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ValidationType {
  AUTOMATIC
  MANUAL
  CONSENSUS
  HYBRID
}

enum QuestionType {
  TEXT
  NUMBER
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  BOOLEAN
  IMAGE
  AUDIO
  VIDEO
  FILE
  LOCATION
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  FLAGGED
}

enum ReviewType {
  AUTOMATIC
  MANUAL
  CONSENSUS
}

enum ReviewDecision {
  APPROVED
  REJECTED
  FLAGGED
}

enum TransactionType {
  TASK_REWARD
  REFERRAL_REWARD
  BONUS
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  REFUND
  FEE
  ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalMethod {
  BANK
  MOBILE_MONEY
  STABLECOIN
  OTHER
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReferralStatus {
  REGISTERED
  VERIFIED
  QUALIFIED
  REWARDED
  BLOCKED
}

enum MissionType {
  DAILY
  WEEKLY
  CAMPAIGN
  SPECIAL
}

enum FraudEventType {
  MULTIPLE_ACCOUNTS
  DEVICE_REUSE
  VPN
  BOT
  IMPOSSIBLE_SPEED
  DUPLICATE_ANSWER
  LOCATION_ANOMALY
  PAYMENT_ANOMALY
  OTHER
}

enum FraudStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  TASK
  PAYMENT
  SECURITY
  REFERRAL
  SYSTEM
}

model UserProfile {
  id           String    @id @default(uuid()) @db.Uuid
  authUserId   String    @unique @db.Uuid
  email        String
  phone        String?   @unique
  role         UserRole  @default(WORKER)
  country      String
  state        String?
  city         String?
  referralCode String    @unique
  referredById String?   @db.Uuid
  isVerified   Boolean   @default(false)
  isSuspended  Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  referredBy         UserProfile?      @relation("ReferralHierarchy", fields: [referredById], references: [id])
  referredUsers      UserProfile[]     @relation("ReferralHierarchy")
  workerProfile      WorkerProfile?
  businesses         Business[]        @relation("BusinessOwner")
  businessMemberships BusinessMember[]
  wallet             Wallet?
  referralsMade      Referral[]        @relation("ReferrerRel")
  referralsReceived  Referral[]        @relation("ReferredUserRel")
  submissions        TaskSubmission[]
  reviews            SubmissionReview[]
  withdrawals        Withdrawal[]
  xpTransactions     XPTransaction[]
  missionProgresses  MissionProgress[]
  fraudEvents        FraudEvent[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([role])
  @@index([country])
  @@index([referralCode])
  @@index([authUserId])
}

model WorkerProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  user             UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  bio              String?
  profilePhoto     String?
  level            Int       @default(1)
  xp               Int       @default(0)
  reputationScore  Decimal   @default(100.0) @db.Decimal(5, 2)
  accuracyScore    Decimal   @default(100.0) @db.Decimal(5, 2)
  completionScore  Decimal   @default(100.0) @db.Decimal(5, 2)
  reliabilityScore Decimal   @default(100.0) @db.Decimal(5, 2)
  fraudScore       Decimal   @default(0.0)   @db.Decimal(5, 2)
  tasksCompleted   Int       @default(0)
  tasksRejected    Int       @default(0)
  totalEarned      Decimal   @default(0.00)  @db.Decimal(12, 2)
  kycStatus        KycStatus @default(NOT_STARTED)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  @@index([level])
  @@index([xp])
  @@index([reputationScore])
  @@index([kycStatus])
}

model Business {
  id                 String             @id @default(uuid()) @db.Uuid
  ownerId            String             @db.Uuid
  owner              UserProfile        @relation("BusinessOwner", fields: [ownerId], references: [id])
  name               String
  legalName          String?
  registrationNumber String?
  email              String
  phone              String
  country            String
  address            String?
  website            String?
  logo               String?
  description        String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  members   BusinessMember[]
  campaigns Campaign[]

  @@index([ownerId])
  @@index([verificationStatus])
}

model BusinessMember {
  id         String             @id @default(uuid()) @db.Uuid
  businessId String             @db.Uuid
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String             @db.Uuid
  user       UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessMemberRole @default(MANAGER)
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([businessId, userId])
  @@index([userId])
}

model TaskCategory {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String
  icon        String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)

  campaigns Campaign[]
  tasks     Task[]

  @@index([slug])
  @@index([isActive])
}

model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @db.Uuid
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String
  categoryId      String         @db.Uuid
  category        TaskCategory   @relation(fields: [categoryId], references: [id])
  country         String
  state           String?
  city            String?
  totalTasks      Int            @default(0)
  completedTasks  Int            @default(0)
  approvedTasks   Int            @default(0)
  rejectedTasks   Int            @default(0)
  budget          Decimal        @db.Decimal(12, 2)
  amountReserved  Decimal        @default(0.00) @db.Decimal(12, 2)
  amountSpent     Decimal        @default(0.00) @db.Decimal(12, 2)
  platformFee     Decimal        @default(0.00) @db.Decimal(12, 2)
  status          CampaignStatus @default(DRAFT)
  startDate       DateTime?      @db.Timestamptz(6)
  endDate         DateTime?      @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  tasks Task[]

  @@index([businessId])
  @@index([status])
  @@index([categoryId])
  @@index([country])
}

model Task {
  id                   String         @id @default(uuid()) @db.Uuid
  campaignId           String         @db.Uuid
  campaign             Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  categoryId           String         @db.Uuid
  category             TaskCategory   @relation(fields: [categoryId], references: [id])
  title                String
  description          String
  instructions         String
  rewardAmount         Decimal        @db.Decimal(10, 2)
  currency             String         @default("USD")
  maxSubmissions       Int            @default(100)
  completedSubmissions Int            @default(0)
  requiredLevel        Int            @default(1)
  requiresKyc          Boolean        @default(false)
  requiresLocation     Boolean        @default(false)
  requiresPhoto        Boolean        @default(false)
  requiresAudio        Boolean        @default(false)
  requiresVideo        Boolean        @default(false)
  validationType       ValidationType @default(MANUAL)
  minimumAccuracy      Decimal?       @db.Decimal(5, 2)
  status               TaskStatus     @default(ACTIVE)
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)

  questions   TaskQuestion[]
  submissions TaskSubmission[]

  @@index([campaignId])
  @@index([categoryId])
  @@index([status])
  @@index([requiredLevel])
}

model TaskQuestion {
  id              String       @id @default(uuid()) @db.Uuid
  taskId          String       @db.Uuid
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  question        String
  questionType    QuestionType
  options         Json?
  validationRules Json?
  isRequired      Boolean      @default(true)
  sortOrder       Int          @default(0)

  @@index([taskId])
  @@index([sortOrder])
}

model TaskSubmission {
  id                String           @id @default(uuid()) @db.Uuid
  taskId            String           @db.Uuid
  task              Task             @relation(fields: [taskId], references: [id])
  workerId          String           @db.Uuid
  worker            UserProfile      @relation(fields: [workerId], references: [id])
  answers           Json
  evidence          Json
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  deviceFingerprint String?
  startedAt         DateTime         @default(now()) @db.Timestamptz(6)
  submittedAt       DateTime         @default(now()) @db.Timestamptz(6)
  reviewedAt        DateTime?        @db.Timestamptz(6)
  status            SubmissionStatus @default(SUBMITTED)
  qualityScore      Decimal?         @db.Decimal(5, 2)
  reviewNotes       String?
  rewardAmount      Decimal?         @db.Decimal(10, 2)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  reviews     SubmissionReview[]
  fraudEvents FraudEvent[]

  @@index([taskId])
  @@index([workerId])
  @@index([status])
  @@index([submittedAt])
}

model SubmissionReview {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @db.Uuid
  submission   TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String?        @db.Uuid
  reviewer     UserProfile?   @relation(fields: [reviewerId], references: [id])
  reviewType   ReviewType     @default(MANUAL)
  decision     ReviewDecision
  score        Decimal?       @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)

  @@index([submissionId])
  @@index([reviewerId])
}

model Wallet {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  user              UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency          String   @default("USD")
  availableBalance  Decimal  @default(0.00) @db.Decimal(12, 2)
  pendingBalance    Decimal  @default(0.00) @db.Decimal(12, 2)
  lifetimeEarned    Decimal  @default(0.00) @db.Decimal(12, 2)
  lifetimeWithdrawn Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  transactions LedgerTransaction[]
  withdrawals  Withdrawal[]

  @@index([userId])
}

model LedgerTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  walletId        String          @db.Uuid
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transactionType TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  direction       LedgerDirection
  reference       String          @unique
  description     String
  status          LedgerStatus    @default(COMPLETED)
  metadata        Json?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)

  @@index([walletId])
  @@index([transactionType])
  @@index([reference])
  @@index([createdAt])
}

model Withdrawal {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  user              UserProfile      @relation(fields: [userId], references: [id])
  walletId          String           @db.Uuid
  wallet            Wallet           @relation(fields: [walletId], references: [id])
  amount            Decimal          @db.Decimal(12, 2)
  fee               Decimal          @default(0.00) @db.Decimal(12, 2)
  netAmount         Decimal          @db.Decimal(12, 2)
  currency          String           @default("USD")
  method            WithdrawalMethod
  destination       Json
  provider          String?
  providerReference String?
  status            WithdrawalStatus @default(REQUESTED)
  riskScore         Decimal          @default(0.0) @db.Decimal(5, 2)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@index([walletId])
  @@index([status])
}

model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  referrerId     String         @db.Uuid
  referrer       UserProfile    @relation("ReferrerRel", fields: [referrerId], references: [id])
  referredUserId String         @db.Uuid
  referredUser   UserProfile    @relation("ReferredUserRel", fields: [referredUserId], references: [id])
  status         ReferralStatus @default(REGISTERED)
  rewardAmount   Decimal        @default(0.00) @db.Decimal(10, 2)
  qualifiedAt    DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  @@unique([referrerId, referredUserId])
  @@index([referrerId])
  @@index([referredUserId])
  @@index([status])
}

model XPTransaction {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      UserProfile @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  reference String?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  @@index([userId])
}

model Mission {
  id           String      @id @default(uuid()) @db.Uuid
  title        String
  description  String
  type         MissionType
  requirements Json
  xpReward     Int         @default(50)
  cashReward   Decimal?    @db.Decimal(10, 2)
  startDate    DateTime    @default(now()) @db.Timestamptz(6)
  endDate      DateTime?   @db.Timestamptz(6)
  isActive     Boolean     @default(true)

  progresses MissionProgress[]

  @@index([type])
  @@index([isActive])
}

model MissionProgress {
  id          String      @id @default(uuid()) @db.Uuid
  missionId   String      @db.Uuid
  mission     Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId      String      @db.Uuid
  user        UserProfile @relation(fields: [userId], references: [id])
  progress    Json
  completed   Boolean     @default(false)
  completedAt DateTime?   @db.Timestamptz(6)

  @@unique([missionId, userId])
  @@index([userId])
}

model FraudEvent {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String?        @db.Uuid
  user         UserProfile?   @relation(fields: [userId], references: [id])
  submissionId String?        @db.Uuid
  submission   TaskSubmission? @relation(fields: [submissionId], references: [id])
  eventType    FraudEventType
  riskScore    Decimal        @db.Decimal(5, 2)
  details      Json
  status       FraudStatus    @default(OPEN)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([submissionId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      UserProfile      @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  user       UserProfile? @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?     @db.Uuid
  ipAddress  String?
  metadata   Json
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}
